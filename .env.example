# Copy to .env and fill in. Never commit a real key.
NEBIUS_API_KEY=
# Optional: pin a model ID (find exact IDs at tokenfactory.nebius.com → Models).
# If empty, the app lets you pick from live /v1/models, preferring NVIDIA ones.
NEBIUS_MODEL=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
